# Cloudflare Worker environment variables
# Copy to wrangler.toml [vars] or set via Cloudflare dashboard

# Domain configuration
BASE_DOMAIN=mctl.ai
GITHUB_ORG=mctlhq
BACKSTAGE_APP_URL=https://app.mctl.ai
NUXT_PUBLIC_FRONT_BASE=http://localhost:3000/
NUXT_VUE_DEVTOOLS=true

# Comma-separated GitHub usernames exempt from tenant-exists check (optional)
UNLIMITED_USERS=

# Turnstile
# Public sitekey for the mctl.ai contact/request-access widgets — not secret,
# safe to commit (Cloudflare's own guidance). This file is the local-dev
# template, so it carries Cloudflare's documented always-passes test sitekey:
# localhost is not on the production widget's hostname allowlist, and the
# production key there would make both forms reject every local submission.
# The production key is 0x4AAAAAAEjFjEMuTRSzlzQc — nuxt.config.ts falls back
# to it automatically for production builds, so it does not belong here.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secrets (set via `wrangler secret put` — never commit these)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_HMAC_KEY=
# BACKSTAGE_LANDING_TOKEN=
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
