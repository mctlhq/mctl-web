# Cloudflare Worker environment variables
# Copy to wrangler.toml [vars] or set via Cloudflare dashboard

# Domain configuration
BASE_DOMAIN=mctl.ai
GITHUB_ORG=mctlhq
BACKSTAGE_APP_URL=https://app.mctl.ai
NUXT_PUBLIC_FRONT_BASE=http://localhost:3000/
NUXT_VUE_DEVTOOLS=true

# Comma-separated GitHub usernames exempt from tenant-exists check (optional)
UNLIMITED_USERS=

# Turnstile
# Public sitekey for the mctl.ai contact/request-access widgets — not secret,
# safe to commit (Cloudflare's own guidance). For local dev, use Cloudflare's
# documented always-passes test sitekey (1x00000000000000000000AA) instead of
# the production key, since localhost is not on the production widget's
# hostname allowlist.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEjFjEMuTRSzlzQc

# Secrets (set via `wrangler secret put` — never commit these)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_HMAC_KEY=
# BACKSTAGE_LANDING_TOKEN=
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
